# Copy this file to .env and fill in real values for local development.
# Never commit a real .env file.

DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=citizen_portal
DATABASE_USER=app_user
DATABASE_PASSWORD=sentinal

JWT_SECRET=sentinal
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

NOTIFICATION_SERVICE_URL=http://notification-service:8000

# Origins the browser is allowed to call the API from (comma-separated).
# Both localhost and 127.0.0.1 are included by default since browsers
# treat them as different origins — add your own if you access the
# frontend from anywhere else (a LAN IP, a devcontainer/Codespaces
# forwarded URL, a real domain, etc).
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# The frontend's build-time API URL — this is what the *browser* calls,
# so if you access the app from somewhere other than localhost:3000 (see
# CORS_ALLOWED_ORIGINS above), update this to match and rebuild the
# frontend image (`docker compose build frontend`).
FRONTEND_API_BASE_URL=http://localhost:8000

# notification-service owns its own Postgres database (one DB per
# microservice). These are read by docker-compose.yml for variable
# interpolation, not injected wholesale into either container, so they
# never collide with citizen-service's DATABASE_* vars above.
NOTIFICATION_DATABASE_NAME=notification_service
NOTIFICATION_DATABASE_USER=app_user
NOTIFICATION_DATABASE_PASSWORD=sentinal

# Chaos Engineering (Phase 10)
CHAOS_MODE=false
CHAOS_FAILURE_RATE=0.3
