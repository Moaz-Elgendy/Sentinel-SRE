# Leave unset (or empty) for the normal deployment: the built image is
# served behind its own nginx reverse proxy in front of sentinel-ai (see
# nginx.conf), so the browser calls same-origin /api/... with no CORS
# involved. Only set this when running the GUI WITHOUT that proxy in front
# of it — e.g. `npm run dev` against a `kubectl port-forward`'d sentinel-ai
# on your laptop.
VITE_API_BASE_URL=http://localhost:8080
