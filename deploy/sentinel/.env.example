# Copy to .env next to docker-compose.yml and fill in.
# On the real EC2 instance this file is generated automatically by
# infra/terraform/sentinel_user_data.sh.tftpl — you only need this for a
# manual/local run of the compose file.

ECR_REGISTRY=<account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REPO_PREFIX=sentinel-sre-demo

# Image tags to run. CI pushes both :latest and :<git-sha> for each of
# sentinel-ai and sentinel-gui — see .github/workflows/ci-cd.yml.
SENTINEL_AI_TAG=latest
SENTINEL_GUI_TAG=latest

# Host ports.
SENTINEL_WEBHOOK_PORT=8080
SENTINEL_GUI_PORT=8081
