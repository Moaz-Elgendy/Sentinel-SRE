__pycache__/
*.pyc
.pytest_cache/
.venv/
venv/
.env
*.egg-info/

# AWS overlay secrets. These hold real database passwords, the JWT signing
# key, the chaos admin token, and Sentinel's OpenAI/GitHub/Slack
# credentials, and are generated at deploy time by
# scripts/generate-aws-secrets.sh. Only the .example templates are tracked.
k8s/overlays/aws/secrets/*.env

# Terraform state contains every resource attribute in plaintext, including
# anything sensitive that passed through a variable. Never commit it.
infra/terraform/.terraform/
# .terraform.lock.hcl is deliberately NOT ignored — it pins provider
# versions by hash, so committing it is what makes `terraform init`
# reproducible across machines.
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/*.tfvars
!infra/terraform/*.tfvars.example
infra/terraform/crash.log
infra/terraform/tfplan
.DS_Store
node_modules/
dist/
build/
