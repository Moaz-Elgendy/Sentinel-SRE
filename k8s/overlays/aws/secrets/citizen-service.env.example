# Copy to citizen-service.env and set real values.
#
# DATABASE_PASSWORD must equal POSTGRES_PASSWORD in citizen-postgres.env —
# there is no automatic linkage between the two Secrets, so a mismatch shows
# up as citizen-service crash-looping on connection failure.
DATABASE_USER=app_user
DATABASE_PASSWORD=CHANGE_ME_must_match_citizen_postgres_env

# Signs the JWTs the portal issues. Changing it invalidates every existing
# session. Generate with: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32

# Authenticates POST /api/chaos/fault. This is a genuinely
# security-sensitive value on AWS in a way it was not on a local kind
# cluster: the chaos API can degrade or take down the service, and the
# service is now on a public IP. The endpoint returns 404 rather than 401 to
# anyone without this token, so it is not discoverable — but do not rely on
# that alone. Generate with: openssl rand -hex 32
CHAOS_ADMIN_TOKEN=CHANGE_ME_openssl_rand_hex_32
