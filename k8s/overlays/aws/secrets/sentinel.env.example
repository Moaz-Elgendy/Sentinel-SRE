# Copy to sentinel.env. Every value here is OPTIONAL — Sentinel starts and
# runs the full incident lifecycle with all of them empty. What each one
# unlocks is stated below, so you can decide what you actually want.

# --- External control plane: Kubernetes connection ------------------------
# How Sentinel reaches the Kubernetes/K3s API it watches. Default
# (in_cluster) is the original deployment shape — Sentinel runs inside the
# same cluster with a ServiceAccount. To run Sentinel OUTSIDE the cluster
# (the intended long-term shape — see docs/sentinel-integration.md), use
# kubeconfig or remote instead:
#
#   KUBERNETES_MODE=kubeconfig
#   KUBERNETES_KUBECONFIG_B64=<base64 of a kubeconfig YAML, scoped to the
#     minimal Role in sentinel-ai/app/clients/kubernetes_client.py's
#     REQUIRED_RBAC — never a full-admin kubeconfig>
#
# or:
#   KUBERNETES_MODE=remote
#   KUBERNETES_API_SERVER=https://<remote-host>:6443
#   KUBERNETES_TOKEN=<a long-lived ServiceAccount token scoped to the same
#     minimal Role>
#   KUBERNETES_CA_CERT_B64=<base64 of the cluster's CA cert; omit only for a
#     throwaway demo cluster reached over a trusted network, and set
#     KUBERNETES_VERIFY_SSL=false explicitly if you do>
KUBERNETES_MODE=in_cluster
KUBERNETES_KUBECONFIG_B64=
KUBERNETES_API_SERVER=
KUBERNETES_TOKEN=
KUBERNETES_CA_CERT_B64=
KUBERNETES_VERIFY_SSL=true

# --- External control plane: identity --------------------------------------
# Seeds the single environment Sentinel registers at startup if none exists
# yet in its SQLite store — see POST /environments to register (and
# activate) a different one without restarting.
CUSTOMER_ID=demo-customer
ENVIRONMENT_ID=demo-env
ENVIRONMENT_NAME=citizen-portal-demo
APPLICATION_ID=citizen-portal

# --- External control plane: Prometheus / Loki -----------------------------
# Must be reachable from wherever Sentinel actually runs. When Sentinel runs
# outside the cluster, this is normally an Ingress/NodePort in front of the
# in-cluster Prometheus/Loki Services, not the ClusterIP DNS name.
PROMETHEUS_URL=http://prometheus:9090
PROMETHEUS_BEARER_TOKEN=
LOKI_URL=http://loki:3100
LOKI_BEARER_TOKEN=

# --- AI reasoning provider ---------------------------------------------
# Selects the Reasoner implementation (openai | gemini). Business logic
# never imports a provider SDK directly — see sentinel-ai/app/reasoning/.
LLM_PROVIDER=openai

# Enables LLM enrichment of root-cause analysis. Without it Sentinel is
# fully rule-based: it still detects, investigates, correlates, decides,
# remediates and validates recovery, and it records in each incident that
# the narrative was produced without LLM enrichment. This costs money per
# incident with real OpenAI, so leaving it unset is a legitimate choice —
# or point it at a free OpenAI-API-compatible provider instead (see
# OPENAI_BASE_URL below), or switch LLM_PROVIDER=gemini instead.
OPENAI_API_KEY=

# Leave unset to use real OpenAI. Set to any OpenAI-API-compatible
# provider's endpoint to use that instead, with zero code changes — e.g.
# Groq: https://api.groq.com/openai/v1 (free tier, no credit card; pair
# with OPENAI_MODEL=llama-3.3-70b-versatile). Confirm your chosen model
# supports JSON response mode before relying on it — Sentinel requires it.
OPENAI_BASE_URL=

# Only needed if OPENAI_BASE_URL is set to a non-default provider whose
# model name differs from OpenAI's. Defaults to gpt-4o-mini.
OPENAI_MODEL=

# Used when LLM_PROVIDER=gemini instead of openai.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Enables automatic GitHub issue creation for incidents, and commit
# correlation for the bad-deployment demo. Needs `repo` scope (or
# `issues: write` + `contents: read` on a fine-grained token) for
# GITHUB_REPOSITORY only. Sentinel never pushes code and never merges
# anything — proposed fixes go in the issue body as text.
GITHUB_TOKEN=
GITHUB_REPOSITORY=owner/repo

SLACK_WEBHOOK_URL=

# --- AWS (optional, EC2 + CloudWatch evidence only; connector present but
# not yet wired into the evidence collector — see docs/sentinel-integration.md
# "Known limitations"). Leave empty to use boto3's default credential chain
# instead (env vars, shared config file, an instance/IRSA role) — preferred
# over hardcoding keys here.
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_EC2_INSTANCE_IDS=

# Lets Sentinel execute the reset_chaos_fault remediation. Must match the
# CHAOS_ADMIN_TOKEN in citizen-service.env / notification-service.env.
# Without it, Sentinel can still *detect* that an incident is a deliberate
# chaos fault (the chaos_* metrics tell it), but cannot clear it — so it
# escalates instead, which is correct behaviour rather than a failure.
CHAOS_ADMIN_TOKEN=

