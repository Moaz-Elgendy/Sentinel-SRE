# Copy to citizen-postgres.env and set real values. The .env file is
# gitignored; this .example file is committed and must never hold a real
# secret.
#
# POSTGRES_USER/POSTGRES_DB must match what citizen-service connects with
# (see citizen-service.env) and what the readiness probe's
# `pg_isready -U app_user -d citizen_portal` expects. Changing the user or
# db name here means changing the probe in k8s/postgres/deployment.yaml too.
POSTGRES_USER=app_user
POSTGRES_PASSWORD=CHANGE_ME_generate_a_random_password
POSTGRES_DB=citizen_portal
