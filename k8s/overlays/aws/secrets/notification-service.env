# Copy to notification-service.env.
# DATABASE_PASSWORD must equal POSTGRES_PASSWORD in notification-postgres.env.
DATABASE_USER=app_user
DATABASE_PASSWORD=CHANGE_ME_must_match_notification_postgres_env

# Can be the same token as citizen-service's or a different one. Sentinel
# needs whichever value is set here in order to reset chaos faults on
# notification-service, so if they differ, set both in sentinel.env.
CHAOS_ADMIN_TOKEN=CHANGE_ME_openssl_rand_hex_32
