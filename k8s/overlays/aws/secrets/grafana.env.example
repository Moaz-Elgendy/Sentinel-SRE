# Copy to grafana.env.
#
# Grafana has no Ingress rule and is ClusterIP-only, so this login is only
# reachable through `kubectl port-forward` over SSM. It still should not be
# admin/admin: anything that can reach the cluster network can reach
# Grafana, and Grafana holds a Prometheus and a Loki datasource.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=CHANGE_ME_generate_a_random_password
